{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "Bash(pnpm:*)",
      "Bash(npx:*)",
      "Bash(turbo:*)",
      "Bash(node:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git checkout:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(mkdir:*)",
      "Bash(echo:*)",
      "Bash(find:*)",
      "Bash(cd packages/form-renderer-web && pnpm exec tsc --noEmit 2>&1 | head -40; cd ../..)",
      "Read(//e/web/web-tool/**)",
      "Read(//tmp/**)",
      "mcp__chrome-devtools__new_page",
      "mcp__chrome-devtools__take_snapshot",
      "mcp__chrome-devtools__list_console_messages",
      "mcp__chrome-devtools__fill",
      "mcp__chrome-devtools__evaluate_script",
      "mcp__chrome-devtools__navigate_page",
      "Bash(kill 9275)",
      "Bash(pkill -f \"vite.*5199\")",
      "Bash(kill 11017 11253)",
      "Bash(pkill -f \"dist/main.js\")",
      "Bash(git --version)",
      "Bash(git config *)",
      "Bash(gh auth *)",
      "Bash(git check-ignore *)",
      "Bash(cat packages/form-core/vitest.config.ts)",
      "Bash(cat packages/form-renderer-web/vitest.config.*)",
      "Bash(cat packages/form-core/vitest.config.*)",
      "Bash(cat packages/form-renderer-web/vitest.setup.ts)",
      "Bash(xargs grep -l \"buildZodSchema\")"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(sudo:*)",
      "Bash(git push:*)",
      "Bash(pnpm publish:*)",
      "Bash(npm publish:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.pem)",
      "Read(**/secrets/**)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path // empty' | xargs -r pnpm biome check --write --no-errors-on-unmatched 2>/dev/null || true"
          }
        ]
      }
    ]
  }
}
