# Copy to `.env` (gitignored) and fill in. Documents every variable the API reads.

# === Database (Prisma) ===
# Postgres connection string — matches the `postgres` service in docker-compose.yml.
# (Before the SQLite->Postgres switch, dev used a file URL e.g. file:./dev.db)
DATABASE_URL="postgresql://formplatform:formplatform@localhost:5432/formplatform?schema=public"

# === HTTP server ===
PORT=3001
# Comma-separated allowlist of browser origins allowed by CORS (no trailing slash).
CORS_ORIGINS="http://localhost:5173"

# === AI (optional, BYOK) ===
# Keys are normally sent per-request (BYOK headers); the values below are DEV-ONLY
# fallbacks / non-secret defaults. Leaving them unset is fine — see ai.config.ts.
AI_PROVIDER=openai
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_ANTHROPIC_MODEL=claude-sonnet-4-6
# AI_API_KEY=
# Comma-separated host allowlist for URLs embedded in AI-generated forms.
AI_URL_ALLOWLIST=
