# Copy to `.env` (gitignored) and fill in. Documents every variable the API reads.

# === Database (Prisma) ===
# Postgres connection string — matches the `postgres` service in docker-compose.yml.
# (Before the SQLite->Postgres switch, dev used a file URL e.g. file:./dev.db)
DATABASE_URL="postgresql://formplatform:formplatform@localhost:5432/formplatform?schema=public"

# === HTTP server ===
PORT=3001
# Comma-separated allowlist of browser origins allowed by CORS (no trailing slash).
# An empty value disables cross-origin requests (no allow-all fallback).
CORS_ORIGINS="http://localhost:5173"

# === Rate limiting (@nestjs/throttler) ===
# Window in milliseconds and the max requests per IP within it. /health is exempt.
THROTTLE_TTL=60000
THROTTLE_LIMIT=120

# === Auth (JWT, production-hardening 2A) ===
# REQUIRED — signing secret for access tokens. Boot fails fast if unset or < 16 chars.
# Generate one, e.g.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="change-me-to-a-long-random-secret"
# Access-token lifetime (@nestjs/jwt syntax): "7d", "12h", or a number of seconds.
JWT_EXPIRES_IN=7d
# Set the Secure flag on the HttpOnly auth cookie (2B). Keep false for local plain-HTTP dev;
# set true in production (HTTPS) so the browser only sends the cookie over TLS.
AUTH_COOKIE_SECURE=false
# Optional bootstrap admin. When both are set and no user id="local" exists yet, the app
# seeds that admin at boot so pre-2A data (ownerId="local") stays owned/reachable.
# AUTH_BOOTSTRAP_EMAIL=admin@example.com
# AUTH_BOOTSTRAP_PASSWORD=changeme123

# === AI (optional, BYOK) ===
# Keys are normally sent per-request (BYOK headers); the values below are DEV-ONLY
# fallbacks / non-secret defaults. Leaving them unset is fine — see ai.config.ts.
AI_PROVIDER=openai
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_ANTHROPIC_MODEL=claude-sonnet-4-6
# AI_API_KEY=
# Comma-separated host allowlist for URLs embedded in AI-generated forms.
AI_URL_ALLOWLIST=
