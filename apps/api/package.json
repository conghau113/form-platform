{
  "name": "@app/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "prisma generate && tsc",
    "postinstall": "prisma generate",
    "start": "node dist/main.js",
    "dev": "tsc && node dist/main.js",
    "typecheck": "prisma generate && tsc --noEmit",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:import": "tsx src/scripts/import-files-to-db.ts"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/platform-express": "^10.4.0",
    "@org/form-ai": "workspace:*",
    "@org/form-schema": "workspace:*",
    "@org/form-theme": "workspace:*",
    "@org/workflow-ai": "workspace:*",
    "@org/workflow-schema": "workspace:*",
    "@prisma/client": "^6.19.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "prisma": "^6.19.3",
    "tsx": "^4.22.4",
    "typescript": "^5.4.0",
    "vitest": "^1.6.1"
  }
}
