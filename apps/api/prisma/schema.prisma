// Track W persistence (W0). The DB holds organisational metadata + form bodies; the form
// JSON contract itself stays pure (no projectId/folderId) — `body` is the migrated contract.
// PostgreSQL (production-hardening 1B). The schema is portable (no native @db.* types); the
// connection string comes from DATABASE_URL — see env.example and docker-compose.yml.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Installation of a single client (product-roadmap Phase B1). `1 tenant = 1 client`. Existing
/// data is backfilled to a personal tenant per distinct `ownerId` (preserving today's isolation);
/// new users get one on first login via `TenantRepo.ensurePersonalTenant`. `kind` is the edition
/// seam (personal|team|enterprise, §6.7). Org/department (B2) and RBAC roles (Phase C) attach later.
model Tenant {
  id        String       @id @default(cuid())
  name      String
  slug      String       @unique
  kind      String       @default("personal")
  members   Membership[]
  projects  Project[]
  orgUnits  OrgUnit[]
  roles     Role[]
  externalApiKeys        ExternalApiKey[]
  externalTicketTypeMaps ExternalTicketTypeMap[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

/// Platform permission catalog (product-roadmap Phase C1). A `Function` is a stable permission *code*
/// (e.g. `form.manage`, `role.admin`) — the atom RBAC grants. Data-driven per §1.1: the platform seeds
/// an immutable base set at boot (`system = true`; see RbacRepo.seedFunctions) so upgrades stay safe;
/// `parentCode` is an optional hierarchy seam. Client-defined functions (a nullable `tenantId`) are a
/// later, additive slice — this slice keeps the catalog a read-only global set. The sentinel code `*`
/// means "all functions" (held by a tenant's admin role), replacing EVN's hardcoded `code==='ADMIN'`.
model Function {
  code        String         @id
  name        String
  parentCode  String?
  system      Boolean        @default(true)
  roles       RoleFunction[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

/// A client-defined role within a tenant (product-roadmap Phase C2). NEVER hardcoded — a client creates
/// roles and maps them to functions (`RoleFunction`) and to users (`UserRole`, many-to-many). The
/// tenant's `system` "admin" role (holding `*`) is auto-provisioned for the tenant owner on login so
/// existing users keep full access under the new model. Scoped to `tenantId`; unique by name per tenant.
model Role {
  id          String         @id @default(cuid())
  tenantId    String
  name        String
  description String?
  system      Boolean        @default(false)
  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  functions   RoleFunction[]
  users       UserRole[]
  dataScopes  DataScope[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([tenantId, name])
  @@index([tenantId])
}

/// Data-scope grant restricting a role to an org-unit subtree (product-roadmap Phase C3). A role with
/// no `DataScope` rows is tenant-wide (backward-compatible); with rows, the role's functions apply only
/// to projects placed under one of these org units (ancestor-or-self). The `*` admin role keeps zero
/// rows → stays tenant-wide. Enforced in `ProjectsService.resolveRoleForProject`, never via SQL alone.
model DataScope {
  id        String  @id @default(cuid())
  roleId    String
  orgUnitId String
  role      Role    @relation(fields: [roleId], references: [id], onDelete: Cascade)
  orgUnit   OrgUnit @relation(fields: [orgUnitId], references: [id], onDelete: Cascade)

  @@unique([roleId, orgUnitId])
  @@index([roleId])
}

/// Grant of a function code to a role (product-roadmap Phase C2). A role's effective permission set is
/// the union of its `functionCode`s; a user's effective set is the union over the roles they hold.
model RoleFunction {
  id           String   @id @default(cuid())
  roleId       String
  functionCode String
  role         Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  function     Function @relation(fields: [functionCode], references: [code], onDelete: Cascade)

  @@unique([roleId, functionCode])
  @@index([functionCode])
}

/// A user ↔ role assignment (product-roadmap Phase C2). Many-to-many: one user may hold several roles;
/// their effective functions are the union across all held roles (within the role's tenant).
model UserRole {
  id        String   @id @default(cuid())
  userId    String
  roleId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
}

/// A node in a tenant's organisational tree (product-roadmap Phase B2). A single unified adjacency-list
/// tree (`parentId`) — a client models any depth (đơn vị → phòng ban → tổ…) with an optional free-form
/// `kind` label, rather than the platform hardcoding EVN's Organization/Department split. Users attach
/// via `Membership.orgUnitId` (Phase D). Data-scope RBAC (Phase C) will grant permissions per org unit.
model OrgUnit {
  id        String       @id @default(cuid())
  tenantId  String
  parentId  String?
  name      String
  kind      String?
  order     Int          @default(0)
  tenant    Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent    OrgUnit?     @relation("OrgUnitTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  OrgUnit[]    @relation("OrgUnitTree")
  members   Membership[]
  projects  Project[]
  dataScopes DataScope[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([tenantId, parentId])
}

/// A user's membership in a tenant (product-roadmap Phase B1). A user may belong to several tenants;
/// in the personal-tenant model there is exactly one. Role/permissions within a tenant are Phase C
/// (RBAC) — this row only records the link.
model Membership {
  id        String   @id @default(cuid())
  userId    String
  tenantId  String
  /// The user's placement in the tenant's org tree (B2 seam; the writer arrives with Phase D admin).
  orgUnitId String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orgUnit   OrgUnit? @relation(fields: [orgUnitId], references: [id], onDelete: SetNull)

  @@unique([userId, tenantId])
  @@index([tenantId])
}

/// Immutable audit trail of sensitive admin actions (product-roadmap §8; write-side lands with D1).
/// Who (`actorId`) did what (`action`, e.g. `role.create`) to which target within a tenant. Plain
/// string references — no FKs — so history survives deletion of the actor/target rows. The read/UI
/// surface is Phase D5; this slice only appends.
model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String
  actorId    String
  action     String
  targetType String?
  targetId   String?
  detail     Json?
  createdAt  DateTime @default(now())

  @@index([tenantId, createdAt])
}

/// Top-level container a user owns (e.g. "HR Platform"). W0 seeds one "Unfiled" project.
model Project {
  id          String          @id @default(cuid())
  ownerId     String
  /// Owning tenant (B1). Defaults to the creator's personal tenant; B4 lets an editor+ member
  /// create into a team tenant instead. `ownerId` stays the canonical creator + Track-W
  /// project-owner role; slugs are unique per tenant (B4 moved the unique off `ownerId`).
  tenantId    String
  /// Placement in the tenant's org tree (C3). Null = unplaced (only tenant-wide roles reach it).
  /// Data-scoped roles grant access only to projects whose org unit is in their scoped subtree.
  orgUnitId   String?
  name        String
  slug        String
  description String?
  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orgUnit     OrgUnit?        @relation(fields: [orgUnitId], references: [id], onDelete: SetNull)
  folders     Folder[]
  forms       FormRecord[]
  workflows   WorkflowRecord[]
  instances   WorkflowInstanceRecord[]
  submissions SubmissionRecord[]
  formVersions FormVersionRecord[]
  presets     Preset[]
  statusCatalog StatusCatalogEntry[]
  members     ProjectMember[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@unique([tenantId, slug])
  @@index([ownerId])
  @@index([orgUnitId])
}

/// Sharing grant for a collaborator (W5). The canonical owner stays `Project.ownerId` (always
/// resolves to the "owner" role); these rows hold *additional* users a project is shared with,
/// so no backfill is needed. `role` is "editor" | "viewer"; `userId` is the `x-owner-id` of the
/// invited user (no user registry yet). One grant per (project, user).
model ProjectMember {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  role      String
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
}

/// Authenticated account (production-hardening 2A). The primary key doubles as the tenant
/// `ownerId` on every existing row — real auth resolves `CurrentOwner` from a verified JWT
/// `sub`, replacing the `x-owner-id` seam non-destructively. A bootstrap admin is seeded with
/// `id = SEED_OWNER_ID ("local")` so pre-2A data keeps its owner. `email` is the login handle.
model User {
  id            String              @id @default(cuid())
  email         String              @unique
  /// Null = the account signs in only through an external provider (product-roadmap A3, Google).
  /// Such an account can still gain a password later through the forgot-password flow.
  passwordHash  String?
  displayName   String?
  /// When the account proved it owns `email` (product-roadmap A2). Null = unverified; nothing
  /// *blocks* on it (soft verification) so every pre-A2 account keeps working untouched.
  emailVerifiedAt DateTime?
  refreshTokens RefreshToken[]
  verificationTokens VerificationToken[]
  memberships   Membership[]
  roles         UserRole[]
  assignedCases WorkflowInstanceRecord[]
  caseRoles     WorkflowInstanceParticipant[]
  notifications Notification[]
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
}

/// A single-use, expiring email token (product-roadmap A2) — one table for both purposes
/// (`email_verify`, `password_reset`) because their lifecycle is identical; `purpose` keeps them
/// apart. Like RefreshToken, only the SHA-256 `tokenHash` is stored: the raw token lives solely in
/// the emailed link, so a DB leak can neither verify an address nor reset a password. `consumedAt`
/// makes redemption single-use; issuing a new token invalidates the account's outstanding ones.
model VerificationToken {
  id         String    @id @default(cuid())
  userId     String
  purpose    String
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
}

/// A long-lived, rotating refresh token (production-hardening A1). The raw token lives only in the
/// client's HttpOnly `refresh_token` cookie; we store its SHA-256 `tokenHash` so a DB leak can't
/// mint sessions. Each `/auth/refresh` revokes the presented row and issues a new one (rotation);
/// `revokedAt` also covers logout. Presenting an already-revoked token whose **session is still
/// live** signals theft/reuse → the service revokes every token for that user; on a session the
/// user already ended it is just a stale client and is rejected without retaliation (P5).
/// `revokeAllForUser` powers "log out of all devices".
///
/// `sessionId` (product-roadmap A2/P5) groups every token a single sign-in ever rotates through, and
/// is what makes the *access* token revocable: it rides in the JWT as `sid`, and `JwtAuthGuard`
/// refuses a token whose session has no live row left. Rotation keeps the same `sessionId`, so
/// `/auth/logout` kills exactly one device while other sessions keep working.
model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  sessionId String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sessionId])
}

/// Adjacency-list tree (parentId) → unlimited nesting. CRUD/endpoints arrive in W1.
model Folder {
  id        String       @id @default(cuid())
  projectId String
  parentId  String?
  name      String
  order     Int          @default(0)
  project   Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent    Folder?      @relation("FolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  Folder[]     @relation("FolderTree")
  forms     FormRecord[]
  workflows WorkflowRecord[]
  createdAt DateTime     @default(now())

  @@index([projectId, parentId])
}

/// Org index for a form. `id` == form.id; `body` is the migrated contract (source of truth
/// stays `migrate()` in FormsService). Listing a folder never has to parse a form body.
model FormRecord {
  id        String   @id
  projectId String
  folderId  String?
  title     String
  status    String?
  body      Json
  /// The published version pointer (FB1). Null until first publish; mirrors the highest
  /// `FormVersionRecord.version`. Runtime (submission) prefers this version's frozen snapshot.
  activeVersion Int?
  /// When the active version was published (FB1). With `updatedAt` it gives a cheap "draft ahead of
  /// published" signal (`updatedAt > publishedAt`) without diffing bodies.
  publishedAt DateTime?
  updatedAt DateTime @updatedAt
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  folder    Folder?  @relation(fields: [folderId], references: [id], onDelete: SetNull)
  submissions SubmissionRecord[]
  versions  FormVersionRecord[]

  @@index([projectId, folderId])
}

/// An immutable published snapshot of a form (Track FB1). `id` == the version id; `body` is the
/// `FormVersion` contract (the migrated form frozen at publish time). `projectId` is denormalised
/// from the parent form so access control never loads the body; `version` is the 1-based publish
/// sequence per form. Publishing is server-authoritative: the service re-`migrate()`s the draft and
/// the active-version pointer + this row are written in one transaction.
model FormVersionRecord {
  id          String   @id @default(cuid())
  formId      String
  projectId   String
  version     Int
  /// Denormalised `body.formVersion` (the contract version of the frozen snapshot) so listing a
  /// form's history never has to load each `body` Json just to read it.
  formVersion Int
  body        Json
  publishedBy String
  publishedAt DateTime @default(now())
  form        FormRecord @relation(fields: [formId], references: [id], onDelete: Cascade)
  project     Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([formId, version])
  @@index([formId])
  @@index([projectId])
}

/// A recorded answer to a form (Track FS1). `id` == the submission id; `body` is the
/// `Submission` contract (incl. the pinned `schemaSnapshot` the data was server-validated
/// against + the validated `data`). `projectId` is denormalised from the parent form so access
/// control never loads the body; `submittedBy`/`submittedAt` are denormalised for cheap listing.
/// Creation is server-authoritative: the service re-validates `data` with `@org/form-core`
/// (never trusting the client) before storing.
model SubmissionRecord {
  id          String   @id
  formId      String
  projectId   String
  submittedBy String
  body        Json
  submittedAt DateTime @default(now())
  form        FormRecord @relation(fields: [formId], references: [id], onDelete: Cascade)
  project     Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([formId])
  @@index([projectId])
}

/// Org index for a workflow (Workflow track WF0). Mirrors {@link FormRecord}: `id` == the
/// definition id; `body` is the migrated workflow contract (source of truth stays
/// `migrateWorkflow()` in WorkflowsService). Listing a folder never has to parse a body.
model WorkflowRecord {
  id        String   @id
  projectId String
  folderId  String?
  title     String
  status    String?
  body      Json
  updatedAt DateTime @updatedAt
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  folder    Folder?  @relation(fields: [folderId], references: [id], onDelete: SetNull)
  instances WorkflowInstanceRecord[]

  @@index([projectId, folderId])
}

/// A running case of a workflow (Workflow track WF3). `id` == the instance id; `body` is the
/// `WorkflowInstance` contract (current state + case data + transition history). `projectId` is
/// denormalised from the parent workflow so access control never has to load the definition, and
/// `current` mirrors `body.current` so a case list stays cheap. Advancing is server-authoritative:
/// the service loads (definition, instance), calls the pure `advance()` engine, and re-stores.
model WorkflowInstanceRecord {
  id         String   @id
  workflowId String
  projectId  String
  current    String
  /// Denormalized human label derived from the case data (deriveCaseLabel) so a case list shows the
  /// subject (e.g. an employee name) without loading each body. Null when no label can be derived.
  label      String?
  /// Who is responsible for the case right now (product-roadmap Phase E work-order). Null = unassigned.
  /// Only ever set through the assign endpoint, which checks the target is a member of the project's
  /// tenant — hence a real FK here (unlike `Project.ownerId`, which may predate the `User` table).
  /// `SetNull` so deleting an account leaves the case standing, merely unassigned.
  assigneeId String?
  /// Denormalized display state, snapshotted from the definition node at every write (same character
  /// as `label`): `statusLabel` is the node's human status and `statusKind` its engine category
  /// (start|normal|end). Lets the work-order list show, filter and sort by a readable status — and
  /// answer "still open?" (`statusKind != 'end'`) — without loading each workflow definition.
  statusLabel String?
  statusKind  String?
  /// When the case is due (Phase E2). Null = no deadline. Like `assigneeId` this is work-order
  /// metadata, not engine state: it lives outside the `WorkflowInstance` contract and is written only
  /// by `setWorkOrderFields`, so advancing a case never disturbs its deadline.
  dueAt      DateTime?
  /// How urgent the case is (Phase E2): 1 = low, 2 = normal, 3 = high. Stored as an INT rather than
  /// a string like `statusKind` because the work-order list sorts on it server-side — `low|normal|high`
  /// would order alphabetically (high, low, normal), and Prisma's `orderBy` cannot take a CASE
  /// expression. Same ownership rule as `dueAt`.
  priority   Int      @default(2)
  body       Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  workflow   WorkflowRecord @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  project    Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee   User?          @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  comments   WorkflowInstanceComment[]
  participants WorkflowInstanceParticipant[]

  @@index([workflowId])
  @@index([projectId])
  @@index([assigneeId])
  /// The work-order list orders a tenant's cases by recency across many projects.
  @@index([projectId, updatedAt])
  /// …and by deadline / urgency (Phase E2), always within the same `projectId IN (...)` filter.
  @@index([projectId, dueAt])
  @@index([projectId, priority])
}

/// A note someone left on a running case (Phase E2). Reading needs project `viewer`; writing needs
/// run access, the same boundary as advancing or assigning the case.
///
/// `authorId` carries no FK and `authorName` is denormalized at write time — both deliberate, for the
/// two reasons already established elsewhere in this schema: `AuditLog` keeps plain string references
/// so history outlives the actor's row, and `label`/`statusLabel` snapshot display state that must
/// survive. A comment is a historical record, so the name as it stood when it was written is the
/// right thing to show, and reading a thread costs zero user lookups. A later display-name change
/// therefore does NOT propagate into old comments.
model WorkflowInstanceComment {
  id         String   @id @default(cuid())
  instanceId String
  authorId   String
  authorName String
  body       String
  createdAt  DateTime @default(now())
  instance   WorkflowInstanceRecord @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  @@index([instanceId, createdAt])
}

/// Someone cast into a domain role on one running case (product-roadmap Phase E3a) — the "who is on
/// this case, in what capacity" list, mirroring EVN's `ticket_role_values`.
///
/// It carries NO step/state column on purpose: the matrix of "(role, action, state) → next state" is
/// already the workflow definition's `transitions`, so duplicating a step here would be a second
/// source of truth that drifts from the graph the moment the graph is edited.
///
/// `roleCode` is matched against `transition.role` by the engine, so this table is what finally makes
/// that check a security boundary: before E3a the acting roles were whatever the CLIENT declared in
/// the request body, which meant anyone able to run a case could unlock `viewRoles`-gated fields by
/// naming the role. `assignee` and `creator` are DERIVED codes (from `assigneeId` / the start event)
/// and are refused here, so a role can never have two sources that disagree.
///
/// The `userId` FK cascades (unlike `assigneeId`, which is `SetNull`): deleting an account should
/// remove it from the cast rather than leave a ghost holding a role — the same rule as `UserRole`.
/// `addedBy` is a bare string with no FK, following `AuditLog.actorId`: it is a historical record of
/// who cast this person, and must outlive that account.
model WorkflowInstanceParticipant {
  id         String   @id @default(cuid())
  instanceId String
  roleCode   String
  userId     String
  addedBy    String
  createdAt  DateTime @default(now())
  instance   WorkflowInstanceRecord @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([instanceId, roleCode, userId])
  @@index([instanceId])
  @@index([userId])
}

/// One in-app notification for one person (product-roadmap Phase E3b).
///
/// Fanned out at WRITE time — an event that concerns five people writes five rows — rather than
/// stored once and joined against a recipient list. That is what makes the unread badge, which every
/// signed-in client polls, a single indexed `COUNT` on `(userId, tenantId, readAt)` instead of a join.
///
/// `title`/`body`/`link` are SNAPSHOTS taken when the event happened, like `WorkflowInstanceComment`
/// and the denormalized case `label`: a notification is a historical statement ("this is what you
/// were told, then"), so it must not silently re-render as the case moves on.
///
/// ⚠️ `title` may only ever be built from data that is already ungated (`WorkflowInstanceSummary.label`,
/// derived through `maskData(..., { roles: [] })`). Building it from `instance.data` would turn the
/// notification feed into a side channel that leaks exactly the `viewRoles`-gated values the case
/// response masks. `tenantId` is carried per row so the bell follows the active workspace switch.
model Notification {
  id         String    @id @default(cuid())
  userId     String
  tenantId   String
  /// Event type, e.g. `case.assigned` — the client maps it to an icon, never to access rules.
  kind       String
  title      String
  body       String?
  targetType String?
  targetId   String?
  /// In-app route to open the thing this is about, e.g.
  /// `/projects/<id>/workflows/<id>/run/<caseId>`. A SNAPSHOT: if the route ever changes, old rows
  /// keep pointing at the old one.
  link       String?
  readAt     DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, tenantId, readAt])
  @@index([userId, tenantId, createdAt])
}

/// Reusable field template. W0 stores them global (scope="global"); W3 adds per-project scope.
model Preset {
  id        String   @id
  scope     String
  projectId String?
  ownerId   String
  name      String
  fieldType String
  icon      String?
  patch     Json
  updatedAt DateTime @updatedAt
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([scope, projectId])
}

/// Reusable workflow status (WE4). Master data mirroring {@link Preset}: `code` is the global PK
/// + the value a workflow node references via `statusCode`; `kind` is the engine category
/// (start|normal|end); `color` is an optional custom override. Global entries (scope="global") are
/// owned by their user; project entries are stored under the project owner (shared library).
model StatusCatalogEntry {
  code      String   @id
  scope     String
  projectId String?
  ownerId   String
  label     String
  kind      String
  color     String?
  updatedAt DateTime @updatedAt
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([scope, projectId])
}

/// A form's saved design tokens, keyed by formId (mirrors the old `<id>.theme.json`).
model Theme {
  formId    String   @id
  tokens    Json
  updatedAt DateTime @updatedAt
}

/// Machine-to-machine credential for the `/external/*` integration surface (EVN §12, D0-a). Follows
/// {@link RefreshToken}: only the SHA-256 digest is stored and lookups go *by* digest through the
/// unique index — so a DB leak cannot mint a key, and there is no plaintext to compare.
///
/// The row carries `tenantId`, and that is the whole tenancy story for this surface: every
/// `/external` read resolves through {@link ExternalTicketTypeMap} scoped to this tenant and is then
/// re-checked against the resolved project's own `tenantId` before anything is returned.
///
/// Known gap, accepted deliberately: a key is **tenant-wide**. Unlike a human caller it does not go
/// through `requireAccess`, so the C3 org-unit data-scope never narrows it. Machine integrations are
/// whole-tenant by design; do not hand one of these to a user-facing client.
model ExternalApiKey {
  id        String    @id @default(cuid())
  tenantId  String
  /// Operator-facing name ("EVN core-service, staging") — never part of authentication.
  label     String
  /// SHA-256 hex of the raw key. Unique so authentication is a single indexed lookup.
  tokenHash String    @unique
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

/// Binds one caller-side ticket type (EVN's `PCT`, `LCT`, …) to the form — and later the workflow —
/// that answers for it (D0-a). Seeded by script; this slice has **no write API** on purpose.
///
/// `formId` is stored directly rather than derived from the workflow: `workflowNodeSchema.formId` is
/// optional, so walking a graph to find "the" form can legitimately come back empty.
model ExternalTicketTypeMap {
  id             String   @id @default(cuid())
  tenantId       String
  /// The caller's vocabulary, e.g. `PCT`. NOT unique on its own: one ticket type legitimately has
  /// several templates behind it (EVN's PCT has six: `CPCT`, `CT_PCT`, `CT_PCT_PDF`, …).
  ticketTypeCode String
  formId         String
  /// The caller's own form code, e.g. `CPCT`. Part of the lookup key — it is what picks *which*
  /// template of that ticket type this row answers for.
  externalFormCode String
  /// Reserved for endpoint C (D2); unused by the form-template read.
  ///
  /// ⚠️ P2-0 left this in an awkward place and D2 must resolve it: the row is now per *template*,
  /// so a ticket type with six templates has six `workflowId` columns to disagree with each other —
  /// while §12.C's request carries no form code to pick between them. Either the workflow binding
  /// moves to its own per-`(tenantId, ticketTypeCode)` table, or C resolves it another way. Do not
  /// let D2 read this column without deciding first.
  workflowId     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// Explicitly named: the default Prisma name for three columns this long is 66 characters, past
  /// Postgres' 63-character identifier limit.
  @@unique([tenantId, ticketTypeCode, externalFormCode], map: "ExternalTicketTypeMap_binding_key")
  @@index([tenantId])
}
