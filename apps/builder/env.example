# Copy to `.env` (gitignored) and fill in. Vite reads VITE_* at build time.
# Per-environment overrides: `.env.test` / `.env.production` (also gitignored) are picked up by
# `vite build --mode test|production`. Only put NON-SECRET values here — Vite bundles VITE_* into
# the browser output. Secrets live in the API .env (see apps/api/env.example).

# Sub-path the SPA is served under (Phase 0). Default when unset: / (served at the root).
# Set e.g. /form-platform-dev, /form-platform-test, /form-platform to host several envs on one domain.
# Drives Vite `base` (vite.config.ts) and the react-router basename (main.tsx).
# VITE_BASE_PATH=/

# Optional human-readable environment label (dev/test/production) for display/diagnostics.
# VITE_APP_ENV=development

# Base path/URL of the @app/api server the builder talks to.
# Default when unset: /api — the same-origin proxy (Vite dev proxy + nginx in prod), which lets
# the HttpOnly auth cookie be sent automatically. Only set an absolute URL if the API is on a
# different origin (then you also need CORS + a cross-site cookie setup). See src/presets/config.ts.
VITE_API_BASE=/api

# Dev-only: where `vite dev` proxies /api to. Defaults to http://localhost:3001 (see vite.config.ts).
# VITE_API_PROXY_TARGET=http://localhost:3001
