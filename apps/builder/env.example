# Copy to `.env` (gitignored) and fill in. Vite reads VITE_* at build time.

# Base path/URL of the @app/api server the builder talks to.
# Default when unset: /api — the same-origin proxy (Vite dev proxy + nginx in prod), which lets
# the HttpOnly auth cookie be sent automatically. Only set an absolute URL if the API is on a
# different origin (then you also need CORS + a cross-site cookie setup). See src/presets/config.ts.
VITE_API_BASE=/api

# Dev-only: where `vite dev` proxies /api to. Defaults to http://localhost:3001 (see vite.config.ts).
# VITE_API_PROXY_TARGET=http://localhost:3001
